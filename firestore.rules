rules_version = '2';

// 認証なし・性善説ベースの簡易ルール（README参照）。
// 「今が誰の手番か」をルール側では判定できないため、手番制御はクライアント側の自己申告に依存する。
// ここでは最低限、データ形式が壊れた書き込み・確定済みゲームへの書き込みだけを防ぐ。
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{roomId} {
      function isValidBoard(board) {
        // 15x15盤をフラットな225要素の配列として保存している（Firestoreはネスト配列非対応のため）
        return board is list && board.size() == 225;
      }

      function isValidNewRoom(data) {
        return data.board is list
          && isValidBoard(data.board)
          && data.turn == 'black'
          && data.visibility in ['public', 'private']
          && data.status == 'waiting'
          && data.winner == null
          && data.winReason == null
          && ((data.players.black is map && data.players.white == null)
            || (data.players.white is map && data.players.black == null))
          && data.createdAt is timestamp
          && data.expiresAt is timestamp;
      }

      allow read: if true;
      allow create: if isValidNewRoom(request.resource.data);
      allow update: if resource.data.status != 'finished'
        && request.resource.data.visibility == resource.data.visibility
        && isValidBoard(request.resource.data.board);
      allow delete: if false;
    }

    match /shogiGames/{roomId} {
      function isValidShogiBoard(board) {
        // 5x5盤をフラットな25要素の配列として保存している（Firestoreはネスト配列非対応のため）
        return board is list && board.size() == 25;
      }

      function isValidNewShogiRoom(data) {
        return data.board is list
          && isValidShogiBoard(data.board)
          && data.turn == 'sente'
          && data.visibility in ['public', 'private']
          && data.status == 'waiting'
          && data.winner == null
          && data.winReason == null
          && ((data.players.sente is map && data.players.gote == null)
            || (data.players.gote is map && data.players.sente == null))
          && data.history is list
          && data.createdAt is timestamp
          && data.expiresAt is timestamp;
      }

      allow read: if true;
      allow create: if isValidNewShogiRoom(request.resource.data);
      allow update: if resource.data.status != 'finished'
        && request.resource.data.visibility == resource.data.visibility
        && isValidShogiBoard(request.resource.data.board);
      allow delete: if false;
    }

    match /tictactoeGames/{roomId} {
      function isValidTicTacToeBoard(board) {
        // 3x3盤をフラットな9要素の配列として保存している（Firestoreはネスト配列非対応のため）
        return board is list && board.size() == 9;
      }

      function isValidNewTicTacToeRoom(data) {
        return data.board is list
          && isValidTicTacToeBoard(data.board)
          && data.turn == 'maru'
          && data.visibility in ['public', 'private']
          && data.status == 'waiting'
          && data.winner == null
          && data.winReason == null
          && ((data.players.maru is map && data.players.batsu == null)
            || (data.players.batsu is map && data.players.maru == null))
          && data.createdAt is timestamp
          && data.expiresAt is timestamp;
      }

      allow read: if true;
      allow create: if isValidNewTicTacToeRoom(request.resource.data);
      allow update: if resource.data.status != 'finished'
        && request.resource.data.visibility == resource.data.visibility
        && isValidTicTacToeBoard(request.resource.data.board);
      allow delete: if false;
    }

    match /otrioGames/{roomId} {
      function isValidOtrioBoard(board) {
        // 3x3盤をフラットな9要素の配列として保存している（各要素はCellオブジェクト）
        return board is list && board.size() == 9;
      }

      function isValidNewOtrioRoom(data) {
        return data.board is list
          && isValidOtrioBoard(data.board)
          && data.turn == 1
          && data.visibility in ['public', 'private']
          && data.status == 'waiting'
          && data.winner == null
          && data.winReason == null
          && data.inventory is map
          && ((data.players['1'] is map && data.players['2'] == null)
            || (data.players['2'] is map && data.players['1'] == null))
          && data.createdAt is timestamp
          && data.expiresAt is timestamp;
      }

      allow read: if true;
      allow create: if isValidNewOtrioRoom(request.resource.data);
      allow update: if resource.data.status != 'finished'
        && request.resource.data.visibility == resource.data.visibility
        && isValidOtrioBoard(request.resource.data.board);
      allow delete: if false;
    }

    match /yonmokuGames/{roomId} {
      function isValidYonmokuBoard(board) {
        // 15x15盤をフラットな225要素の配列として保存している（五目並べと同じ構造）
        return board is list && board.size() == 225;
      }

      function isValidNewYonmokuRoom(data) {
        return data.board is list
          && isValidYonmokuBoard(data.board)
          && data.turn == 'black'
          && data.visibility in ['public', 'private']
          && data.status == 'waiting'
          && data.winner == null
          && data.winReason == null
          && ((data.players.black is map && data.players.white == null)
            || (data.players.white is map && data.players.black == null))
          && data.createdAt is timestamp
          && data.expiresAt is timestamp;
      }

      allow read: if true;
      allow create: if isValidNewYonmokuRoom(request.resource.data);
      allow update: if resource.data.status != 'finished'
        && request.resource.data.visibility == resource.data.visibility
        && isValidYonmokuBoard(request.resource.data.board);
      allow delete: if false;
    }

    match /gobbletGames/{roomId} {
      function isValidGobbletBoard(board) {
        // 3x3盤、各マスを「駒スタックを固定長3要素にエンコードした数値配列」として保存しているため
        // 9マス×3要素=27要素のフラット配列になる
        return board is list && board.size() == 27;
      }

      function isValidNewGobbletRoom(data) {
        return data.board is list
          && isValidGobbletBoard(data.board)
          && data.turn == 1
          && data.visibility in ['public', 'private']
          && data.status == 'waiting'
          && data.winner == null
          && data.winReason == null
          && data.inventory is map
          && data.history is list
          && ((data.players['1'] is map && data.players['2'] == null)
            || (data.players['2'] is map && data.players['1'] == null))
          && data.createdAt is timestamp
          && data.expiresAt is timestamp;
      }

      allow read: if true;
      allow create: if isValidNewGobbletRoom(request.resource.data);
      allow update: if resource.data.status != 'finished'
        && request.resource.data.visibility == resource.data.visibility
        && isValidGobbletBoard(request.resource.data.board);
      allow delete: if false;
    }

    // プレイ記録（履歴ページ用）。対局が決着した時に1件だけ書き込まれる、追記のみのログ。
    // 認証なしの公開ページから誰でも読める前提のため、個人を特定できる情報は持たない
    match /playRecords/{recordId} {
      function isValidGameId(game) {
        return game in ['gomoku', 'gogo-shogi', 'tictactoe', 'otrio', 'yonmoku', 'gobblet', 'stonepush'];
      }

      function isValidCpuRecord(data) {
        return data.difficulty in ['easy', 'medium', 'hard']
          && data.outcome in ['win', 'lose', 'draw'];
      }

      function isValidOnlineRecord(data) {
        return data.winnerLabel == null || data.winnerLabel is string;
      }

      function isValidNewRecord(data) {
        return isValidGameId(data.game)
          && data.mode in ['cpu', 'online']
          && data.playedAt is timestamp
          && ((data.mode == 'cpu' && isValidCpuRecord(data)) || (data.mode == 'online' && isValidOnlineRecord(data)));
      }

      allow read: if true;
      allow create: if isValidNewRecord(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }
  }
}
