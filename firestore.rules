rules_version = '2';

// 認証なし・性善説ベースの簡易ルール（README参照）。
// 「今が誰の手番か」をルール側では判定できないため、手番制御はクライアント側の自己申告に依存する。
// ここでは最低限、データ形式が壊れた書き込み・確定済みゲームへの書き込みだけを防ぐ。
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{roomId} {
      function isValidBoard(board) {
        // 15x15盤をフラットな225要素の配列として保存している（Firestoreはネスト配列非対応のため）
        return board is list && board.size() == 225;
      }

      function isValidNewRoom(data) {
        return data.board is list
          && isValidBoard(data.board)
          && data.turn == 'black'
          && data.visibility in ['public', 'private']
          && data.status == 'waiting'
          && data.winner == null
          && data.players.black is map
          && data.players.white == null
          && data.createdAt is timestamp
          && data.expiresAt is timestamp;
      }

      allow read: if true;
      allow create: if isValidNewRoom(request.resource.data);
      allow update: if resource.data.status != 'finished'
        && request.resource.data.visibility == resource.data.visibility
        && isValidBoard(request.resource.data.board);
      allow delete: if false;
    }

    match /shogiGames/{roomId} {
      function isValidShogiBoard(board) {
        // 5x5盤をフラットな25要素の配列として保存している（Firestoreはネスト配列非対応のため）
        return board is list && board.size() == 25;
      }

      function isValidNewShogiRoom(data) {
        return data.board is list
          && isValidShogiBoard(data.board)
          && data.turn == 'sente'
          && data.visibility in ['public', 'private']
          && data.status == 'waiting'
          && data.winner == null
          && data.winReason == null
          && data.players.sente is map
          && data.players.gote == null
          && data.history is list
          && data.createdAt is timestamp
          && data.expiresAt is timestamp;
      }

      allow read: if true;
      allow create: if isValidNewShogiRoom(request.resource.data);
      allow update: if resource.data.status != 'finished'
        && request.resource.data.visibility == resource.data.visibility
        && isValidShogiBoard(request.resource.data.board);
      allow delete: if false;
    }
  }
}
